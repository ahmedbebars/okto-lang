# نفس اللغة بكلمات عربية
دالة مجموع(أرقام: قائمة[عدد]) -> عدد:
    متغير الناتج = 0
    لكل رقم في أرقام:
        الناتج = الناتج + رقم
    ارجع الناتج

ثابت درجات = [90، 75، 60]
ثابت الكل = مجموع(درجات)

اطبع("المجموع: {الكل}")

إذا الكل > 200:
    اطبع("ممتاز")
وإلا إذا الكل > 150:
    اطبع("جيد")
وإلا:
    اطبع("يحتاج مراجعة")

ثابت مدخل = إلى_عدد("abc")
اطبع("القيمة: {مدخل ?? 0}")
